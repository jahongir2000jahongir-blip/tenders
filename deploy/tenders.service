[Unit]
Description=tenders.best web + collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tenders
WorkingDirectory=/opt/tenders
EnvironmentFile=-/opt/tenders/.env
ExecStart=/opt/tenders/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
